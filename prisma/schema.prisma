generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  image        String
  images       String[] @default([])
  category     String
  priceMin     Int
  priceMax     Int
  description  String?  @db.Text
  quantity     Int      @default(0)
  isNewArrival Boolean  @default(false)
  isOnSale     Boolean  @default(false)
  inStock      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @default(0)
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  trackingId String      @unique
  txRef      String      @unique
  fullName   String
  phone      String
  email      String
  address    String
  city       String
  state      String
  status     String      @default("pending") // pending | paid | processing | shipped | delivered | failed
  total      Int
  items      OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  name      String
  image     String
  price     Int
  qty       Int
}